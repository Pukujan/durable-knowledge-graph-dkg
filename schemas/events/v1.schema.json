{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/schemas/events/v1.schema.json",
  "title": "DKG Durable Knowledge Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "recorded_at",
    "pack_id",
    "actor",
    "subject_refs",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "dkg.event.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{16,}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "examples": ["claim.proposed", "claim.state_changed", "relation.superseded", "ontology.concept_split"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the represented real-world or intellectual event occurred, if known."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this immutable event was committed to the corpus."
    },
    "pack_id": {
      "type": "string",
      "pattern": "^pack_[A-Za-z0-9_-]{16,}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id"],
      "properties": {
        "actor_type": {
          "enum": ["human", "agent", "service", "importer", "system"]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": ["string", "null"]
        },
        "harness_version": {
          "type": ["string", "null"]
        },
        "skill_id": {
          "type": ["string", "null"]
        },
        "skill_version": {
          "type": ["string", "null"]
        }
      }
    },
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "caused_by_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evt_[A-Za-z0-9_-]{16,}$"
      },
      "default": []
    },
    "correlation_id": {
      "type": ["string", "null"],
      "description": "Groups events from one research/agent/import operation without making the group part of knowledge identity."
    },
    "idempotency_key": {
      "type": ["string", "null"],
      "description": "Stable operation key used to reject accidental duplicate commits."
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      },
      "default": []
    },
    "source_snapshot_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      },
      "default": []
    },
    "payload_schema": {
      "type": ["string", "null"],
      "format": "uri-reference",
      "description": "Optional event-type-specific schema reference."
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": ["string", "null"]
        },
        "software_commit": {
          "type": ["string", "null"]
        },
        "ontology_version": {
          "type": ["string", "null"]
        },
        "retrieval_policy_version": {
          "type": ["string", "null"]
        },
        "prompt_or_policy_ref": {
          "type": ["string", "null"]
        },
        "trace_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
