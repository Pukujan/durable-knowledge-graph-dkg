{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/schemas/conversation-lineage/v1.schema.json",
  "title": "FOSSIL Conversation Lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "conversation_id",
    "nodes",
    "edges",
    "current_conclusion_refs"
  ],
  "properties": {
    "schema_version": {"const": "fossil.conversation-lineage.v1"},
    "lineage_id": {
      "type": "string",
      "pattern": "^lin_[A-Za-z0-9_-]{12,}$"
    },
    "conversation_id": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "kind",
          "label",
          "text",
          "evidence_status",
          "position_state",
          "source_message_refs",
          "source_span_refs"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^ln_[A-Za-z0-9_-]{8,}$"
          },
          "kind": {
            "enum": [
              "observation",
              "question",
              "claim",
              "challenge",
              "rebuttal",
              "assumption",
              "conclusion",
              "position_change",
              "decision"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_status": {
            "enum": ["verbatim", "reconstructed"]
          },
          "position_state": {
            "enum": ["current", "historical", "opposing", "unresolved"]
          },
          "source_message_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "source_span_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "source_node_id", "target_node_id", "relation_type"],
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^le_[A-Za-z0-9_-]{8,}$"
          },
          "source_node_id": {"type": "string"},
          "target_node_id": {"type": "string"},
          "relation_type": {
            "enum": [
              "leads_to",
              "supports",
              "challenges",
              "rebuts",
              "reframes",
              "supersedes",
              "depends_on"
            ]
          }
        }
      }
    },
    "current_conclusion_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
