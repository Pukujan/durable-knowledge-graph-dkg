{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/schemas/source-snapshot/v1.schema.json",
  "title": "FOSSIL Source Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "source_id",
    "source_role",
    "locator",
    "retrieved_at",
    "published_at",
    "artifact_id",
    "content_hash",
    "version_metadata",
    "quality",
    "derivation"
  ],
  "properties": {
    "schema_version": {"const": "fossil.source-snapshot.v1"},
    "snapshot_id": {"type": "string", "pattern": "^snap_[A-Za-z0-9_-]{12,}$"},
    "source_id": {"type": "string", "pattern": "^source_[A-Za-z0-9_-]{8,}$"},
    "source_role": {
      "enum": ["primary", "secondary", "derived", "reconstructed", "local"]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": ["string", "null"]},
        "identifier": {"type": ["string", "null"]},
        "repository_ref": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"required": ["url"]},
        {"required": ["identifier"]},
        {"required": ["repository_ref"]}
      ]
    },
    "retrieved_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "artifact_id": {"type": "string", "pattern": "^art_[A-Za-z0-9_-]{16,}$"},
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "etag": {"type": ["string", "null"]},
        "last_modified": {"type": ["string", "null"]},
        "version_id": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "directness", "independence", "reproducibility", "timeliness"],
      "properties": {
        "authority": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "directness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "independence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reproducibility": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "timeliness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "notes": {"type": "string"}
      }
    },
    "derivation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "parent_snapshot_refs"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "parent_snapshot_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^snap_[A-Za-z0-9_-]{12,}$"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_role": {"enum": ["derived", "reconstructed"]}}},
      "then": {"properties": {"derivation": {"type": "object"}}}
    }
  ]
}
