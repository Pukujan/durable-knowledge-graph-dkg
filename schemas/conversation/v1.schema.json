{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/schemas/conversation/v1.schema.json",
  "title": "FOSSIL Durable Conversation Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "source_status",
    "sources",
    "spans",
    "messages"
  ],
  "properties": {
    "schema_version": {"const": "fossil.conversation.v1"},
    "conversation_id": {
      "type": "string",
      "pattern": "^conv_[A-Za-z0-9_-]{12,}$"
    },
    "source_status": {
      "enum": ["verbatim", "reconstructed", "mixed"]
    },
    "title": {"type": "string"},
    "reconstruction_basis_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "artifact_id", "evidence_status"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src_[A-Za-z0-9_-]{8,}$"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^art_[A-Za-z0-9_-]{16,}$"
          },
          "evidence_status": {
            "enum": ["verbatim", "reconstructed"]
          },
          "label": {"type": "string"},
          "media_type": {"type": "string"},
          "external_ref": {"type": ["string", "null"]}
        }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_id",
          "source_id",
          "byte_start",
          "byte_end",
          "evidence_status"
        ],
        "properties": {
          "span_id": {
            "type": "string",
            "pattern": "^span_[A-Za-z0-9_-]{8,}$"
          },
          "source_id": {"type": "string"},
          "byte_start": {"type": "integer", "minimum": 0},
          "byte_end": {"type": "integer", "minimum": 1},
          "evidence_status": {
            "enum": ["verbatim", "reconstructed"]
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "sequence",
          "parent_message_id",
          "actor",
          "evidence_status",
          "text",
          "source_span_refs"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "pattern": "^msg_[A-Za-z0-9_-]{8,}$"
          },
          "sequence": {"type": "integer", "minimum": 0},
          "parent_message_id": {"type": ["string", "null"]},
          "occurred_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "role"],
            "properties": {
              "actor_id": {"type": "string", "minLength": 1},
              "role": {
                "enum": ["human", "assistant", "system", "tool", "other"]
              },
              "provider": {"type": ["string", "null"]},
              "model_id": {"type": ["string", "null"]},
              "run_id": {"type": ["string", "null"]},
              "tool_id": {"type": ["string", "null"]}
            }
          },
          "evidence_status": {
            "enum": ["verbatim", "reconstructed"]
          },
          "text": {"type": "string", "minLength": 1},
          "source_span_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
