{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/schemas/agent-skill/v1.schema.json",
  "title": "FOSSIL Agent Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "name",
    "summary",
    "methodology_ref",
    "capabilities",
    "triggers"
  ],
  "properties": {
    "schema_version": {"const": "fossil.agent-skill.v1"},
    "skill_id": {
      "type": "string",
      "pattern": "^skill_[a-z0-9_-]{4,}$"
    },
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "methodology_ref": {"type": "string", "pattern": "^SKILL\\.md$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["search", "context", "read", "lineage", "propose", "validate", "commit", "manage"]
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "risk_notes": {"type": "string"}
  }
}
