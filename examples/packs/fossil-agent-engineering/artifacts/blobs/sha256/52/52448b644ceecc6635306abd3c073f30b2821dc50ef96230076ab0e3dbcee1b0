\"_465\":8484,\"_467\":468,\"_470\":471,\"_472\":8485,\"_474\":475},[8461],{\"_1284\":1451,\"_1452\":1453,\"_472\":8490},1786905067.7735016,{\"_1279\":1280,\"_1281\":8489},{\"_493\":494,\"_499\":7765,\"_501\":7765,\"_506\":8486,\"_1442\":1443,\"_1444\":8487,\"_1446\":8488,\"_1296\":1317,\"_1299\":8401,\"_512\":10,\"_1448\":26},\"944e3414-da98-4192-a6a2-aa76d8a79e20\",[8488],\"Searching 4 websites\",[1450],{\"_1287\":1455},{\"_454\":8420,\"_461\":8494,\"_47\":8495,\"_465\":8496,\"_467\":468,\"_469\":14,\"_470\":471,\"_472\":8497,\"_474\":1453},\"95373fe6-1928-43d2-aa94-d205fc274a5b\",[8421],{\"_1284\":1285,\"_472\":8506},1786905049.906428,{\"_1279\":1496,\"_1497\":1498,\"_1280\":8505},{\"_478\":8498,\"_480\":26,\"_488\":8499,\"_481\":8500,\"_490\":60,\"_1397\":26,\"_1398\":26,\"_1399\":471,\"_493\":494,\"_495\":7764,\"_497\":498,\"_499\":7765,\"_501\":7765,\"_502\":60,\"_59\":60,\"_503\":504,\"_506\":8501,\"_1444\":8502,\"_1446\":2183,\"_1296\":1317,\"_1320\":8503,\"_1322\":1323,\"_1299\":8401,\"_507\":7766,\"_509\":26,\"_510\":7767,\"_512\":10,\"_505\":14},{\"_43\":1275,\"_1276\":8504},[],[],\"885b04e6-9bd6-481c-847f-055264269b5c\",[2183],[1493],[1495],\"{\\\"open\\\":[{\\\"ref_id\\\":\\\"turn238999search0\\\"},{\\\"ref_id\\\":\\\"turn887158academia12\\\"},{\\\"ref_id\\\":\\\"turn118431academia12\\\"},{\\\"ref_id\\\":\\\"turn118431academia15\\\"},{\\\"ref_id\\\":\\\"turn585649search0\\\"},{\\\"ref_id\\\":\\\"turn585649search3\\\"},{\\\"ref_id\\\":\\\"turn118431search0\\\"}],\\\"response_length\\\":\\\"long\\\"}\",{},{\"_454\":8492,\"_461\":8510,\"_47\":8495,\"_465\":8511,\"_467\":468,\"_469\":14,\"_470\":471,\"_472\":8512,\"_474\":475,\"_476\":1507},\"bc1439cb-ff94-4931-878a-38a142669e02\",[8420],{\"_1284\":1285,\"_472\":8517},{\"_1279\":1280,\"_1281\":8515},{\"_486\":8513,\"_488\":8514,\"_490\":60,\"_1510\":26,\"_1397\":26,\"_1398\":26,\"_1399\":471,\"_1322\":1323,\"_1299\":8401,\"_493\":494,\"_495\":7764,\"_497\":498,\"_499\":7765,\"_501\":7765,\"_502\":60,\"_59\"