"_1127\":3703,\"_55\":3704,\"_1130\":3705,\"_40\":1983,\"_1133\":-5,\"_43\":1158,\"_1159\":3706,\"_1161\":3707,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3690,\"_1124\":-5,\"_1125\":3691,\"_1127\":3692,\"_55\":3693,\"_1130\":3694,\"_40\":3695,\"_1133\":-5,\"_43\":1158,\"_1159\":3696,\"_1161\":3697,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3678,\"_1124\":-5,\"_1125\":3679,\"_1127\":3680,\"_55\":3681,\"_1130\":3682,\"_40\":3683,\"_1133\":-5,\"_43\":1158,\"_1159\":3684,\"_1161\":3685,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3663,\"_1124\":-5,\"_1125\":3664,\"_1127\":3665,\"_55\":3666,\"_1130\":3667,\"_40\":3668,\"_1133\":-5,\"_43\":1158,\"_1159\":3669,\"_1161\":3670,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3649,\"_1124\":-5,\"_1125\":3650,\"_1127\":3651,\"_55\":3652,\"_1130\":3653,\"_40\":3654,\"_1133\":-5,\"_43\":1158,\"_1159\":3655,\"_1161\":3656,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3635,\"_1124\":-5,\"_1125\":3636,\"_1127\":3637,\"_55\":3638,\"_1130\":3639,\"_40\":3640,\"_1133\":-5,\"_43\":1158,\"_1159\":3641,\"_1161\":3642,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3622,\"_1124\":-5,\"_1125\":3623,\"_1127\":3624,\"_55\":3625,\"_1130\":3626,\"_40\":3614,\"_1133\":-5,\"_43\":1158,\"_1159\":3627,\"_1161\":3628,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3609,\"_1124\":-5,\"_1125\":3610,\"_1127\":3611,\"_55\":3612,\"_1130\":3613,\"_40\":3614,\"_1133\":-5,\"_43\":1158,\"_1159\":3615,\"_1161\":3616,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3598,\"_1124\":-5,\"_1125\":3599,\"_1127\":3600,\"_55\":3601,\"_1130\":3602,\"_40\":2748,\"_1133\":-5,\"_43\":1158,\"_1159\":3603,\"_1161\":3604,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":3587,\"_1124\":-5,\"_1125\":3588,\"_1127\":3589,\"_55\":3590,\"_1130\":3591,\"_40\":1983,\"_1133\":-5,\"_43\":1158,\"_1159\":3592,\"_1161\":3593,\"_467\":1163,\"_1164\":-5,\"_1165\":-5},{\"_1122\":1123,\"_1124\":-5,\"_1125\":3574,\"_1127\":3575,\"_55\":3576,\"_1130\":3577,\"_40\":1132,\"_1133\":-5,\"_43\":1134,\"_1135\":3578,\"_1137\":14},16601,16602,[],[],[3579,3580,3581,3582],{\"_46\":1896,\"_34\":1593,\"_664\":1149},{\"_46\":3585,\"_34\":3250,\"_664\":3586},{\"_46\":3344,\"_34\":3254,\"_664\":3344},{\"_46\":3583,\"_34\":3246,\"_664\":3584},\"An unexpected discovery: Automated reasoning often makes systems more efficient and easier to maintain | AWS Security Blog\",\"Amazon Web Services, Inc.\",\"Fuzz target generation using LLMs | OSS-Fuzz\",\"Google GitHub\",\"citeturn879118academia24\",14435,14462,[1592,1593],[],[3594],[],{\"_46\":1896,\"_34\":1593,\"_664\":1149,\"_663\":1987,\"_659\":1132,\"_1167\":-5,\"_1168\":3595,\"_1130\":3596,\"_1171\":-5,\"_1172\":-5},[],[3597],{\"_665\":666,\"_667\":1188,\"_669\":739},\"citeturn753224academia12\",12301,12328,[2395,2396],[],[3605],[],{\"_46\":2752,\"_34\":2396,\"_664\":1149,\"_663\":2753,\"_659\":1132,\"_1167\":-5,\"_1168\":3606,\"_1130\":3607,\"_1171\":-5,\"_1172\":-5},[],[3608],{\"_665\":1047,\"_667\":1188,\"_669\":936},\"citeturn753224search3\",10694,10718,[3245,3246],[],\"([Amazon Web Services, Inc.](https://aws.amazon.com/blogs/security/an-unexpected-discovery-automated-reasoning-often-makes-systems-more-efficient-and-easier-to-maintain/?utm_source=chatgpt.com))\",[3617],[],{\"_46\":3583,\"_34\":3246,\"_664\":3584,\"_663\":3618,\"_659\":1132,\"_1167\":-5,\"_1168\":3619,\"_1130\":3620,\"_1171\":-5,\"_1172\":-5},1729123200,[],[3621],{\"_665\":1047,\"_667\":668,\"_669\":844},\"citeturn753224search3turn753224search7\",10467,10509,[3245,3246,3247,3248],[],[3629],[],{\"_46\":3583,\"_34\":3246,\"_664\":3584,\"_663\":3618,\"_659\":1132,\"_1167\":-5,\"_1168\":3630,\"_1130\":3631,\"_1171\":-5,\"_1172\":-5},[3634],[3632,3633],{\"_665\":1047,\"_667\":668,\"_669\":844},{\"_665\":1047,\"_667\":668,\"_669\":962},{\"_46\":3477,\"_34\":3248,\"_663\":-5,\"_659\":1132,\"_664\":3584},\"citeturn358405academia26\",7603,7630,[3243,3244],[],\"([arXiv](https://arxiv.org/abs/2605.22175?utm_source=chatgpt.com))\",[3643],[],{\"_46\":3644,\"_34\":3244,\"_664\":1149,\"_663\":3645,\"_659\":1132,\"_1167\":-5,\"_1168\":3646,\"_1130\":3647,\"_1171\":-5,\"_1172\":-5},\"SWE-Mutation: Can LLMs Generate Reliable Test Suites in Software Engineering?\",1779353150,[],[3648],{\"_665\":471,\"_667\":1188,\"_669\":915},\"citeturn358405academia24\",7355,7382,[3240,3241],[],\"([arXiv](https://arxiv.org/abs/2501.12862?utm_source=chatgpt.com))\",[3657],[],{\"_46\":3658,\"_34\":3241,\"_664\":1149,\"_663\":3659,\"_659\":1132,\"_1167\":-5,\"_1168\":3660,\"_1130\":3661,\"_1171\":-5,\"_1172\":-5},\"Mutation-Guided LLM-based Test Generation at Meta\",1737551642,[],[3662],{\"_665\":471,\"_667\":1188,\"_669\":739},\"citeturn358405search0turn358405search11\",5437,5480,[3251,3252,3253,3254],[],\"([Hypothesis](https://hypothesis.works/articles/how-hypothesis-works/?utm_source=chatgpt.com))\",[3671],[],{\"_46\":3344,\"_34\":3254,\"_664\":3344,\"_663\":3672,\"_659\":1132,\"_1167\":-5,\"_1168\":3673,\"_1130\":3674,\"_1171\":-5,\"_1172\":-5},1481328000,[3677],[3675,3676],{\"_665\":471,\"_667\":668,\"_669\":666},{\"_665\":471,\"_667\":668,\"_669\":957},{\"_46\":3344,\"_34\":3252,\"_663\":-5,\"_659\":1132,\"_664\":3344},\"citeturn879118search4\",4426,4450,[3249,3250],[],\"([Google GitHub](https://google.github.io/oss-fuzz/research/llms/target_generation/?utm_source=chatgpt.com))\",[3686],[],{\"_46\":3585,\"_34\":3250,\"_664\":3586,\"_663\":-5,\"_659\":1132,\"_1167\":-5,\"_1168\":3687,\"_1130\":3688,\"_1171\":-5,\"_1172\":-5},[],[3689],{\"_665\":666,\"_667\":668,\"_669\":970},\"citeturn879118academia27\",4053,4080,[3074,3242],[],\"([arXiv](https://arxiv.org/abs/2503.07800?utm_source=chatgpt.com))\",[3698],[],{\"_46\":3075,\"_34\":3242,\"_664\":1149,\"_663\":3077,\"_659\":1132,\"_1167\":-5,\"_1168\":3699,\"_1130\":3700,\"_1171\":-5,\"_1172\":-5},[],[3701],{\"_665\":666,\"_667\":1188,\"_669\":910},844,871,[1592,1593],[],[3708],[],{\"_46\":1896,\"_34\":1593,\"_664\":1149,\"_663\":1987,\"_659\":1132,\"_1167\":-5,\"_1168\":3709,\"_1130\":3710,\"_1171\":-5,\"_1172\":-5},[],[3711],{\"_665\":666,\"_667\":1188,\"_669\":739},[1278],[3714],\"Yes. And I think the main failure point is now much clearer:\\n\\n\u003e **Coding agents are getting fast enough that implementation is no longer necessarily the bottleneck. The bottleneck becomes proving that the thing they rapidly implemented is actually the thing the human meant.**\\n\\nThat is a different engineering problem.\\n\\nA coding agent can take a vague sentence, silently fill in ten assumptions, write code, write tests consistent with those assumptions, run them, review itself, and report success. The whole loop can be internally coherent and externally wrong.\\n\\nThere is already evidence that clarification itself materially matters. A 2026 study created underspecified SWE-bench tasks and separated “detect ambiguity / ask” from “implement”; the clarification-seeking system resolved 69.4% versus 61.2% for the standard single-agent setup. citeturn879118academia24\\n\\nSo I would **change the lifecycle of agentic engineering**, not merely add more reviewers.\\n\\n## Cheap inference should become a verification resource\\n\\nIf you have effectively free access to several strong models, spending all of that inference on more implementation agents is wasteful.\\n\\nThe interesting use is:\\n\\n```text\\n          HUMAN INTENT\\n               │\\n               ▼\\n       requirements dialogue\\n               │\\n       ┌───────┴────────┐\\n       │                │\\n   ambiguities       invariants\\n       │                │\\n       └───────┬────────┘\\n               ▼\\n        frozen contract\\n               │\\n       ┌───────┴────────────────────────────┐\\n       │                                    │\\n IMPLEMENTATION PLANE              VERIFICATION PLANE\\n       │                                    │\\n Codex / Claude                 independent agents\\n       │                         fuzzers\\n       │                         mutants\\n       │                         formal models\\n       │                         synthetic users\\n       │                         fault injection\\n       │                         holdout tests\\n       │                         critics\\n       │                                    │\\n       └────────────────┬───────────────────┘\\n                        ▼\\n                evidence / failures\\n                        │\\n                 human decision\\n```\\n\\nThe key architectural separation is **implementation versus verification**.\\n\\nThe implementer must not own every oracle used to approve itself.\\n\\n---\\n\\n## Your “1,000 Luna conversations” idea can be extremely useful\\n\\nBut I would not call:\\n\\n\u003e 1,000 conversations passed\\n\\nevidence of correctness.\\n\\nInstead, use a frontier model as a **semantic interaction fuzzer**.\\n\\nSuppose you're building a chatbot and the human requirement is roughly:\\n\\n\u003e “The bot should remember the project correctly and help me modify it.”\\n\\nOne agent might generate normal interactions.\\n\\nAnother deliberately behaves like an impatient user.\\n\\nAnother repeatedly changes its mind.\\n\\nAnother supplies contradictory project information.\\n\\nAnother returns after a simulated week.\\n\\nAnother corrects the assistant halfway through.\\n\\nAnother asks something whose answer was superseded 80 turns earlier.\\n\\nAnother tries two projects with similar names.\\n\\nAnother deliberately makes typos like a real user.\\n\\nAnother asks a question the system has insufficient evidence to answer.\\n\\nAnother creates tool failures mid-conversation.\\n\\nAnd you don't run those once.\\n\\nYou generate stateful interaction trajectories:\\n\\n```text\\nuser\\n ↓\\nsystem\\n ↓\\nuser mutation\\n ↓\\nsystem\\n ↓\\ncorrection\\n ↓\\nsystem\\n ↓\\ntool failure\\n ↓\\nuser follows up\\n ↓\\ncontext compaction\\n ↓\\nuser asks about original fact\\n```\\n\\nHundreds or thousands of them.\\n\\nThat's much closer to **fuzzing a protocol** than ordinary chatbot evaluation.\\n\\nLLMs have already been successfully used as interactive simulated clients for requirements-elicitation training, although the study also observed that simulated clients sometimes became imprecise or contradictory. That's exactly why I would use the synthetic user as a *challenge generator*, not as the authority on what the product should do. citeturn879118academia27\\n\\n---\\n\\n# But the number `1000` is the wrong optimization target\\n\\nThis is important.\\n\\nGoogle's OSS-Fuzz experience is a huge warning here. Even projects subjected to enormous amounts of continuous fuzzing can have low runtime coverage; Google reports roughly 30% runtime coverage across many OSS-Fuzz projects despite massive accumulated compute. citeturn879118search4\\n\\nSo:\\n\\n```text\\n1,000 random conversations\\n```\\n\\ncould be worse than:\\n\\n```text\\n70 deliberately different conversations\\n```\\n\\nif those 70 systematically exercise the requirement state space.\\n\\nWe want metrics like:\\n\\n```text\\nrequirement coverage\\nstate-transition coverage\\ninvariant coverage\\nfailure-mode coverage\\nmutation kill rate\\nnovel failure count\\ndistinct failure clusters\\nboundary-value coverage\\npersona/interaction coverage\\ntool-failure coverage\\ntemporal-state coverage\\n```\\n\\nnot merely:\\n\\n```text\\nnumber_of_model_calls = 12,842\\n```\\n\\nCheap inference lets us explore aggressively, but **coverage tells us whether the exploration is useful**.\\n\\n---\\n\\n# Property-based testing fits beautifully here\\n\\nClassic property-based systems such as Hypothesis don't require humans to enumerate every example. You specify what should remain true across a space of values, and the system explores that space. When it finds a failure, Hypothesis tries to shrink that failure to a simpler reproducing case. citeturn358405search0turn358405search11\\n\\nWe can apply the same concept above raw function inputs.\\n\\nFor a chatbot:\\n\\n```text\\nPROPERTY\\n\\nIf the user explicitly corrects Fact X,\\nfuture answers must not silently use superseded X\\nunless the user asks for historical state.\\n```\\n\\nNow an LLM interaction fuzzer can generate thousands of ways of getting there.\\n\\nEventually it finds:\\n\\n```text\\nturn 4: project database = SQLite\\nturn 19: no, we switched to PostgreSQL\\nturn 63: unrelated discussion\\nturn 91: context compression\\nturn 118: \\\"what db are we using?\\\"\\nassistant: SQLite\\n```\\n\\nFAIL.\\n\\nThen an agent should **shrink the conversation**.\\n\\nMaybe the minimal reproduction is:\\n\\n```text\\nUser: We use SQLite.\\nAssistant: Got it.\\n\\nUser: Actually we moved to Postgres.\\nAssistant: Got it.\\n\\n... context reset ...\\n\\nUser: Which DB?\\nAssistant: SQLite.\\n```\\n\\nThat's an extraordinarily useful bug report.\\n\\nA 118-turn failure becomes a 5-step reproducible regression fixture.\\n\\n---\\n\\n# Mutation testing attacks the tests themselves\\n\\nThis is another place where free models can give you enormous leverage.\\n\\nDon't merely ask:\\n\\n\u003e Does implementation A pass?\\n\\nDeliberately create **incorrect implementations**.\\n\\nFor example:\\n\\n```text\\ncorrect:\\nif claim.state == \\\"superseded\\\":\\n    exclude_current()\\n\\nmutant:\\nif claim.state != \\\"superseded\\\":\\n    exclude_current()\\n```\\n\\nor:\\n\\n```text\\nremove pack scope check\\nignore recorded_at\\nchange \u003e= to \u003e\\nskip citation verification\\ntreat empty retrieval as success\\n```\\n\\nNow ask:\\n\\n\u003e **Does our test system detect the broken implementation?**\\n\\nIf not, the problem isn't necessarily the production code.\\n\\nYour **tests are weak**.\\n\\nMeta has actually deployed an LLM-assisted mutation-testing system at scale. Their ACH system generates faults that existing tests miss, then has LLMs generate tests designed to detect those mutants; it was applied across more than 10,000 Android Kotlin classes in several Meta platforms. citeturn358405academia24\\n\\nAnd recent research is very cautionary about trusting LLM-generated tests themselves: SWE-Mutation found current models frequently fail to create test suites capable of distinguishing realistic mutated implementations. citeturn358405academia26\\n\\nThat reinforces your concern:\\n\\n\u003e **The coding model saying “my tests pass” should be almost irrelevant to promotion.**\\n\\n---\\n\\n# Hidden holdouts should be generated before the implementation sees them\\n\\nThis is another big improvement.\\n\\nAt the beginning of a phase:\\n\\n```text\\nhuman requirement\\n      ↓\\nrequirements agent\\n      ↓\\nclarification dialogue\\n      ↓\\nacceptance contract\\n      ↓\\nholdout generator\\n      ↓\\nSEALED HOLDOUT SET\\n```\\n\\nThen:\\n\\n```text\\ncoding agent\\n    does NOT see holdouts\\n```\\n\\nAfter implementation:\\n\\n```text\\nevaluation broker\\n    runs public tests\\n    runs mutations\\n    runs hidden holdouts\\n    runs fuzz interaction corpus\\n```\\n\\nThat breaks the circular loop somewhat.\\n\\nI'd go further and use **multiple sources** for the holdouts:\\n\\n```text\\nhuman-written anchor tests\\n+\\nmodel A generated adversarial scenarios\\n+\\nmodel B critiques them\\n+\\nproperty generator\\n+\\nmutation-derived tests\\n+\\nhistorical real bugs\\n```\\n\\nBecause hiding a bad oracle doesn't turn it into a good oracle.\\n\\n---\\n\\n# Cross-model diversity is useful, but it isn't independent evidence\\n\\nThis distinction matters.\\n\\nYou can absolutely use:\\n\\n```text\\nGPT model\\nClaude\\nGemini\\nQwen\\nDeepSeek\\nCodex\\nspecialized OSS model\\n```\\n\\nto search from different priors and produce different critiques.\\n\\nThat's valuable.\\n\\nBut:\\n\\n```text\\n7 models agree\\n```\\n\\ndoes not mean:\\n\\n```text\\ntruth proven\\n```\\n\\nThey may share training data, common coding idioms, benchmark assumptions, or just converge on the same plausible mistake.\\n\\nSo I'd use model diversity for **search breadth**:\\n\\n\u003e “Find something the others missed.”\\n\\nNot evidence multiplication:\\n\\n\u003e “Seven votes = truth.”\\n\\nThe actual oracle should preferentially come from executable behavior, specifications, formal properties, historical incidents, external observations, or human product judgment.\\n\\n---\\n\\n# TLA+ / formal tools fit at a different level\\n\\nYou wouldn't run TLA+ against every CRUD feature.\\n\\nBut for things involving:\\n\\n```text\\nconcurrency\\ndistributed state\\nretry semantics\\nidempotency\\nleader election\\nevent ordering\\ntransactions\\nlifecycle transitions\\nrecovery\\n```\\n\\nyou can have an ephemeral **formalization agent**.\\n\\nIt gets the design but not the implementation and tries to turn assumptions into an explicit state machine:\\n\\n```text\\nState\\n  current_claim\\n  event_log\\n  projection\\n  failure_mode\\n\\nInvariant:\\n  projection_truth ⊆ durable_truth\\n\\nInvariant:\\n  redacted_event never resurrects\\n\\nInvariant:\\n  retry(commit(event)) creates ≤ 1 durable event\\n\\nInvariant:\\n  superseded claim never resolves as current\\n```\\n\\nThen TLC or another model checker explores the state space.\\n\\nAWS explicitly uses formal/automated reasoning for precisely this class of problem because ordinary testing and design review can miss rare combinations of states and failures; AWS reports using these techniques in systems such as S3 and IAM. citeturn753224search3turn753224search7\\n\\nAnd importantly, AWS does **not** say formal methods replace testing. It describes design review, stress testing, fault injection and automated reasoning as complementary mechanisms. citeturn753224search3\\n\\nThat's how I'd use it.\\n\\n---\\n\\n# The tool broker becomes extremely important\\n\\nInstead of making every agent an omnipotent coding agent, give ephemeral specialists constrained tool surfaces:\\n\\n```text\\n                 VERIFICATION BROKER\\n\\n requirements-agent ─── ask human / inspect docs\\n\\n invariant-agent ────── read spec / emit candidate invariants\\n\\n TLA-agent ──────────── TLC / Apalache / P\\n\\n mutation-agent ─────── mutation engine\\n\\n fuzz-agent ─────────── Hypothesis / fuzz runners\\n\\n user-simulator ─────── product API only\\n\\n fault-agent ────────── inject timeout/network/storage faults\\n\\n critic-agent ───────── read-only repo + evidence\\n\\n reproducer ─────────── shrink/minimize failure\\n\\n implementer ────────── source-write capability\\n\\n evaluator ──────────── hidden tests, no source-write\\n```\\n\\nNotice the asymmetry.\\n\\nThe test evaluator doesn't need permission to rewrite production code.\\n\\nThe implementer doesn't need permission to edit hidden evaluation criteria.\\n\\nThe synthetic user should interact through the **actual public interface**, not inspect implementation internals.\\n\\nThat's how you get meaningful separation.\\n\\n---\\n\\n# Ephemeral agents also help with context rot\\n\\nThis connects strongly to your other concern.\\n\\nDon't keep one coding agent alive for:\\n\\n```text\\nPhase 1\\nPhase 2\\n...\\nPhase 93\\nPhase 94\\n```\\n\\nwith a gigantic conversation full of obsolete assumptions.\\n\\nLong-context models are not uniformly good at using all supplied context; the “Lost in the Middle” results found substantial performance sensitivity to where relevant information appears in long prompts. citeturn753224academia12\\n\\nInstead:\\n\\n```text\\ncanonical project state\\n        │\\n        ▼\\n    task packet\\n        │\\n        ├── exact requirements\\n        ├── applicable architecture\\n        ├── current decisions\\n        ├── relevant files\\n        ├── known failures\\n        └── acceptance criteria\\n        │\\n        ▼\\n fresh ephemeral agent\\n```\\n\\nWhen it finishes:\\n\\n```text\\nagent disappears\\n       ↓\\ncompact receipt survives\\n       ↓\\ncanonical project state changes only\\nthrough accepted artifacts/evidence\\n```\\n\\nThat makes the conversation disposable.\\n\\nThe **project isn't the chat**.\\n\\nThis is philosophically very close to what we've been saying about FOSSIL itself.\\n\\n---\\n\\n# And your biggest process correction is before code\\n\\nI agree strongly with this, but I'd make it adaptive rather than forcing every tiny task through a giant interview.\\n\\nCurrent coding agents tend to interpret:\\n\\n\u003e “Build X.”\\n\\nas authorization to infer missing requirements.\\n\\nFor anything materially underspecified, the actual flow should be:\\n\\n```text\\nHuman request\\n      ↓\\nIs outcome sufficiently specified?\\n      │\\n      ├─ YES → continue\\n      │\\n      └─ NO\\n          ↓\\n     clarification dialogue\\n          ↓\\n      expose choices\\n          ↓\\n    human narrows intent\\n          ↓\\n     executable acceptance\\n```\\n\\nFor example, instead of:\\n\\n\u003e “Add project memory.”\\n\\nand the agent immediately coding, it could discover:\\n\\n```text\\nWhat should memory contain?\\n\\nShould projects be isolated?\\n\\nShould deleted information remain historically queryable?\\n\\nShould user corrections replace old values\\nor preserve both temporally?\\n\\nWho is allowed to promote project information?\\n\\nWhat should happen when the system is uncertain?\\n\\nWhat is the actual user-visible success case?\\n```\\n\\nYou don't necessarily need twenty questions.\\n\\nBut you need enough that the **important architectural ambiguity is converted from hidden assumption to explicit choice**.\\n\\nThe clarification-seeking coding-agent evidence I mentioned earlier is particularly relevant because it found that proactively asking on underspecified tasks improved resolution rather than merely slowing the agent down. citeturn879118academia24\\n\\n---\\n\\n# I would therefore change “phases”\\n\\nInstead of:\\n\\n```text\\nplan 100 phases\\n→ execute 100 phases\\n→ human inspects final product\\n```\\n\\nI think the unit should become:\\n\\n```text\\nINTENT GATE\\nhuman + agent establish observable outcome\\n\\n      ↓\\n\\nSPEC GATE\\ninvariants + acceptance examples + non-goals\\nholdouts frozen\\n\\n      ↓\\n\\nDESIGN ATTACK\\ncritics/formalizer try to break design\\n\\n      ↓\\n\\nIMPLEMENT\\n\\n      ↓\\n\\nVERIFICATION ATTACK\\nunit\\nintegration\\nproperty\\nmutation\\nfuzz\\ninteraction fuzz\\nfault injection\\nhidden holdout\\ncross-model critique\\n\\n      ↓\\n\\nREAL OUTCOME\\nshadow/canary/user interaction where applicable\\n\\n      ↓\\n\\nHUMAN / EXTERNAL ACCEPTANCE\\n\\n      ↓\\n\\nNEXT PHASE\\n```\\n\\nNot every gate needs to be heavy.\\n\\nRisk decides how much machinery is activated.\\n\\nChanging a label doesn't need TLA+ and 1,000 conversations.\\n\\nChanging FOSSIL's durable event semantics very well might.\\n\\n---\\n\\n## The core change is epistemic\\n\\nToday an agent loop often looks like:\\n\\n```text\\nagent believes requirement\\n→ agent writes code\\n→ agent writes test of its belief\\n→ test agrees\\n→ SUCCESS\\n```\\n\\nWhat you're describing is closer to:\\n\\n```text\\nhuman intent\\n→ interrogate ambiguity\\n→ externally visible contract\\n→ independently generated attacks\\n→ implementation\\n→ counterexample search\\n→ measured behavior\\n→ human/external judgment\\n```\\n\\nThat's a much stronger engineering loop.\\n\\nAnd **free inference changes its economics dramatically**.\\n\\nIf inference is abundant, we shouldn't use 1,000 calls to ask 1,000 agents to produce the same code.\\n\\nUse those 1,000 calls to try to **disprove the implementation**:\\n\\n```text\\nfind an ambiguity\\nfind an invariant violation\\nfind a missing state\\nfind a race\\nfind a bad migration\\nfind a weird user\\nfind a contradictory request\\nfind a hidden dependency\\nfind a mutant the tests can't kill\\nfind an old bug that returned\\nfind a conversation that corrupts state\\n```\\n\\nThen preserve only the minimized counterexamples and durable lessons.\\n\\nThat's where large amounts of inexpensive frontier inference could change software engineering substantially: **turn model compute from a code-generation budget into a counterexample-search budget.**\",{\"_1287\":1288},{\"_454\":3160,\"_461\":3719,\"_47\":3720,\"_465\":3721,\"_467\":468,\"_469\":14,\"_470\":471,\"_472\":3722,\"_474\":475},\"fe3d2955-f598-44a2-aa4f-c64bda011f33\",[3144],{\"_1284\":1285,\"_472\":3726},1786906498.496012,{\"_1279\":1305,\"_465\":3725},{\"_1296\":1297,\"_1298\":696,\"_1299\":3723,\"_1301\":3724,\"_1303\":1304,\"_493\":494,\"_495\":3174,\"_497\":498,\"_499\":3175,\"_501\":3175,\"_490\":60,\"_502\":60,\"_59\":60,\"_503\":504,\"_505\":14,\"_506\":3717,\"_507\":3176,\"_509\":26,\"_510\":3177,\"_512\":10},1786906458.3687572,1786906498.4833221,\"Worked for 40s\",{},{\"_454\":3717,\"_461\":3730,\"_47\":3731,\"_465\":3732,\"_467\":468,\"_469\":14,\"_470\":471,\"_472\":3733,\"_474\":475},\"b351f068-389b-47e9-9006-09587f47850a\",[3160],{\"_1284\":1285,\"_472\":3746},1786906497.883195,{\"_1279\":1376,\"_1376\":3738,\"_1378\":3737},{\"_1296\":1317,\"_1320\":3734,\"_488\":3735,\"_481\":3736,\"_490\":60,\"_1397\":26,\"_1398\":26,\"_1399\":471,\"_493\":494,\"_495\":3174,\"_497\":498,\"_499\":3175,\"_501\":3175,\"_502\":60,\"_59\":60,\"_503\":504,\"_506\":3737,\"_1401\":1402,\"_1322\":1323,\"_1299\":3723,\"_1324\":1325,\"_505\":14,\"_507\":3176,\"_509\":26,\"_510\":3177,\"_512\":10},[],[],[],\"bb31bd1f-89ae-483e-b01f-fb3ec2dcb125\",[3739,3740],{\"_1381\":3743,\"_465\":3744,\"_1383\":3745,\"_1385\":26},{\"_1381\":3741,\"_465\":1132,\"_1383\":3742,\"_1385\":26},\"Structured assurance architecture\",[],\"Structuring assurance architecture\",\"I’m shaping a verification mesh: separate implementers from evaluators, use withheld holdout tests, formalize only narrow properties, and combine mutation, fuzzing, fault injection, cross-model critique, shadow rollout, rollback, and human outcome revi