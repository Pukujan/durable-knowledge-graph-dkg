{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fossil.local/contracts/engineering/closeout-v1.schema.json",
  "title": "Engineering closeout receipt v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "outcome", "changed_files", "tests", "terminal_status", "evidence"],
  "properties": {
    "version": {"const": "closeout-v1"},
    "contract_version": {"const": "closeout-v1"},
    "identifiers": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "issue": {"type": "integer", "minimum": 1},
        "pull_request": {"type": "integer", "minimum": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "work_order_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1}
      }
    },
    "outcome": {"type": "string", "minLength": 1},
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminal_status": {"enum": ["PASS", "FAILED", "BLOCKED"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "stage": {"enum": ["local", "staging", "live"]},
          "digest": {"type": "string", "minLength": 1}
        }
      }
    },
    "live_staging_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "observed_failure_behavior": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback_or_rebuild_proof": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "new_operational_dependency": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions_disproven": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "assumptions_remaining": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "lesson_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["proposal", "status"],
        "properties": {
          "proposal": {"type": "string", "minLength": 1},
          "status": {"const": "PROPOSAL"},
          "target": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}