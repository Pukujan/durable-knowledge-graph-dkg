{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/fossil-core/contracts/properties/property-catalog-v1.schema.json",
  "title": "FOSSIL Property Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "properties"
  ],
  "properties": {
    "catalog_version": {
      "const": "fossil.property-catalog.v1"
    },
    "architecture_ref": {
      "type": "string",
      "minLength": 1
    },
    "issue_ref": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/property"
      }
    }
  },
  "$defs": {
    "path_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "statement",
        "criticality",
        "semantic_owner",
        "modules",
        "deterministic_oracles",
        "property_oracles",
        "mutation_scope",
        "tla_refs",
        "lean_refs",
        "hidden_acceptance_required",
        "status",
        "source_refs"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "pattern": "^FOSSIL-PROP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "semantic_owner": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "$ref": "#/$defs/path_refs"
        },
        "deterministic_oracles": {
          "$ref": "#/$defs/path_refs"
        },
        "property_oracles": {
          "$ref": "#/$defs/path_refs"
        },
        "mutation_scope": {
          "$ref": "#/$defs/path_refs"
        },
        "tla_refs": {
          "$ref": "#/$defs/path_refs"
        },
        "lean_refs": {
          "$ref": "#/$defs/path_refs"
        },
        "hidden_acceptance_required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "planned",
            "deferred",
            "retired"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/path_refs"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
